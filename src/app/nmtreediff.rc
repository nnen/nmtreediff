/**
 * @file nmtreediff.rc
 * @brief Windows resources of the nmtreediff executable.
 *
 * The icon is found through the include path that src/app/CMakeLists.txt sets
 * for this file. It is generated by tools/generate_icon.py.
 *
 * The resource name is not arbitrary: GLFW loads the icon named GLFW_ICON for
 * every window it creates, so this one resource gives the window, the taskbar
 * and Alt+Tab their icon. Explorer shows the first icon of an executable, and
 * this is the only one.
 */

GLFW_ICON ICON "nmtreediff.ico"
